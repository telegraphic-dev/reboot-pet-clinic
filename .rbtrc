generate api/
generate --python=backend/api/
generate --react=web/src/api
generate --web=web/src/api
dev run --watch=backend/api/**/*.py
dev run --watch=backend/src/**/*.py
dev run --python
dev run --application-name=petclinic-local
dev expunge --application-name=petclinic-local
dev run --application=backend/src/main.py

# Single-container production: Reboot keeps durable state on the mounted
# volume and Caddy proxies it from the public SPA origin.
serve run --python
serve run --application=backend/src/main.py
serve run --application-name=petclinic
serve run --servers=1
serve run --tls=external
